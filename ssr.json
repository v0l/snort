{
  "site_name": "Snort",
  "description": "Snort is a feature-packed, decentralized social media client built on Nostr protocol. Fast, censorship-resistant, and open source.",
  "default_image": "/nostrich_512.png",
  "public_url": "https://snort.social",
  "relays": [
    "wss://relay.snort.social",
    "wss://nos.lol",
    "wss://relay.damus.io",
    "wss://relay.primal.net"
  ],
  "live": true,
  "kinds": [0, 1, 5, 30023],
  "max_events": 150000,
  "backfill": [
    { "filter": { "kinds": [0] }, "max": 20000, "priority": true },
    { "filter": { "kinds": [30023] }, "max": 5000, "priority": true },
    { "filter": { "kinds": [1] }, "max": 20000 }
  ],
  "sitemap": [
    { "name": "profiles", "filter": { "kinds": [0] }, "encoding": "npub", "prefix": "/", "changefreq": "weekly", "priority": "0.6" },
    { "name": "articles", "filter": { "kinds": [30023] }, "encoding": "naddr", "prefix": "/", "changefreq": "monthly", "priority": "0.7" },
    { "name": "notes", "filter": { "kinds": [1] }, "max": 20000, "encoding": "nevent", "prefix": "/e/", "priority": "0.5" },
    { "name": "hashtags", "filter": { "kinds": [1] }, "group": "tag", "min_count": 3, "prefix": "/t/", "changefreq": "daily", "priority": "0.4" }
  ],
  "dist": "/app/dist",
  "bundle": "/app/dist/ssr/render.js",
  "opengraph": {
    "nip05_url": "https://api.snort.social/.well-known/nostr.json?name={name}",
    "nip05_headers": {
      "X-Proxy-Host": "{host}"
    },
    "nip05_domain": "snort.social",
    "skip_paths": [
      "/login",
      "/new",
      "/help",
      "/about",
      "/search",
      "/notifications",
      "/messages",
      "/settings",
      "/wallet",
      "/changelog",
      "/subscribe",
      "/zap-pool",
      "/nostr-address",
      "/free-nostr-address",
      "/cache-debug",
      "/component-debug",
      "/trending",
      "/following",
      "/global"
    ]
  },
  "proxy": [
    {
      "prefix": "/.well-known/nostr.json",
      "upstream": "https://api.snort.social",
      "forward_path": true,
      "headers": {
        "X-Proxy-Host": "{host}"
      }
    },
    {
      "prefix": "/.well-known/lnurlp/",
      "upstream": "https://api.snort.social",
      "forward_path": true,
      "headers": {
        "X-Proxy-Host": "{host}"
      }
    }
  ],
  "headers": [
    {
      "prefix": "/",
      "set": {
        "Content-Security-Policy": "default-src 'self'; manifest-src *; child-src 'none'; worker-src 'self'; frame-src youtube.com www.youtube.com https://platform.twitter.com https://embed.tidal.com https://w.soundcloud.com https://www.mixcloud.com https://open.spotify.com https://player.twitch.tv https://embed.music.apple.com https://embed.wavlake.com https://play.3speak.tv https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; connect-src *; img-src * data: blob:; font-src 'self'; media-src * blob:; script-src 'self' 'wasm-unsafe-eval' https://platform.twitter.com https://embed.tidal.com https://challenges.cloudflare.com",
        "Cross-Origin-Opener-Policy": "same-origin"
      }
    }
  ],
  "static_paths": [
    "/"
  ]
}
