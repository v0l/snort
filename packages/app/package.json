  "scripts": {
    "start": "bunx --bun vite",
    "build": "bunx vite build",
    "build:ssr": "SSR_CLIENT=true bunx vite build && SSR=true bunx vite build",
    "serve": "bunx --bun vite preview",
    "dev:ssr": "bun server/dev.ts",
    "serve:ssr": "bun run server/prod.ts",
    "build:all": "bun run build && bun run build:ssr",
    "typecheck": "bunx --bun tsc --noEmit",
    "test:e2e": "bunx playwright test",
    "test:e2e:coverage": "E2E_COVERAGE=1 bunx playwright test",
    "intl-extract": "bunx --bun formatjs extract 'src/**/*.ts*' --ignore='**/*.d.ts' --out-file src/lang.json --flatten true",
    "intl-compile": "bunx --bun formatjs compile src/lang.json --ast --out-file src/translations/en.json",
    "eslint": "bunx --bun eslint ."
  },
  "browserslist": {
    "production": ["chrome >= 67", "edge >= 79", "firefox >= 68", "opera >= 54", "safari >= 14"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "devDependencies": {
