{
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "noImplicitOverride": true,
    "module": "ESNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["./src/**/*.ts"],
  "files": ["./src/index.ts"]
}
